# Copy this file to .env and add local credentials. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:4173
OPENROUTER_APP_NAME=ShapeShift Dynamic CV

# Decision layer: choose `typesafe` for the direct Jev API or `openrouter` as fallback.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Direct Jev API root. The SDK appends /v1/systemone.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
# Used only when JEV_PROVIDER=openrouter.
JEV_MODEL=~typesafe/jev-latest
CV_WRITER_MODEL=~openai/gpt-luna-latest
CV_EDITOR_MODEL=~openai/gpt-astra-latest
MIN_DECISION_CONFIDENCE=0.80
ALLOW_UNVERIFIED_CLAIMS=false
ANALYSIS_MODE=demo
